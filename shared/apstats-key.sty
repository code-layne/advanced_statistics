\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{apstats-key}[2026/06/01 AP Statistics answer-key additions]

\RequirePackage{apstats-boxes}

% ── Answer macros ─────────────────────────────────────────────────────────────
% \ans{text}      — inline answer (colored bold); replaces blanks or write lines
% \ansline{text}  — answer that fills a full write line with a dotted trail
\newcommand{\ans}[1]{\textcolor{keyred}{\textbf{#1}}}
\newcommand{\ansline}[1]{%
    \vspace{1pt}\noindent\textcolor{keyred}{\textbf{#1}}%
    \textcolor{linegray}{\dotfill}\vspace{3pt}}

% ── Component identification table (key version) ──────────────────────────────
% Usage: \componenttablekey{individual}{population}{sample}{variable(s)}
\newcommand{\componenttablekey}[4]{%
    \renewcommand{\arraystretch}{1.8}%
    \begin{tabularx}{\linewidth}{@{} >{\bfseries\color{navy}}p{0.22\linewidth} X @{}}
    Individual:  & \ans{#1} \\
    Population:  & \ans{#2} \\
    Sample:      & \ans{#3} \\
    Variable(s): & \ans{#4} \\
    \end{tabularx}}

% ── The work rule — show what the blank reserved ──────────────────────────────
% `work` is defined in apstats-boxes and authored byte-identically in the blank
% and the key. The blank ships a \vphantom of the block (its exact height, no
% ink); loading this package flips the same block visible, in keyred. That is
% what keeps every component the same number of pages blank and keyed — see the
% commentary in apstats-boxes.sty.
\aps@workvisibletrue

% ── Teacher note box ──────────────────────────────────────────────────────────
% `teachernote` now lives in apstats-boxes (it takes an optional component
% title) because teacher prose belongs in the LESSON PLAN, which loads -boxes
% only. Keys still inherit it through the \RequirePackage above, so any key not
% yet migrated keeps compiling — but new notes go in the plan, not the key.
