% ── Fill-in helpers ───────────────────────────────────────────────────────────
\newcommand{\blank}[1]{\underline{\hspace{#1}}}
\newcommand{\writeline}{\vspace{1pt}\noindent\textcolor{linegray}{\hrulefill}\vspace{3pt}}
% \writelines{n} — n ruled writing lines. The line breaks go BETWEEN the rules,
% never after the last one: a trailing \\ leaves a spurious empty line that the
% key's \ansline has no counterpart for, and that one line is enough to push a
% blank a page past its key. Keep this break-separated, not break-terminated.
\newcommand{\writelines}[1]{%
  \writeline
  \@tempcnta=1\relax
  \loop\ifnum\@tempcnta<#1\relax
    \\\writeline
    \advance\@tempcnta by 1\relax
  \repeat}
% \termblank{Term} — one vocabulary row: the term, then a rule running to the
% end of the line to write the definition on, then open space to run over into.
% There is no second full-width line. The row is a FIXED-HEIGHT box, so the key's
% \termans (apstats-key) occupies exactly the same height whether its definition
% sets on one line or two — the vocabulary box cannot drift blank vs. keyed.
\newcommand{\termrowheight}{1.30cm}
% Leading inset ABOVE each vocabulary term, taken from INSIDE the fixed row
% height — the row still costs exactly \termrowheight, so no lesson's page count
% moves. It buys the gap the first term was missing under the box's intro line.
\newlength{\termrowinset}
\setlength{\termrowinset}{7pt}
\newlength{\aps@termwd}
\newcommand{\termblank}[1]{%
  \settowidth{\aps@termwd}{\textbf{#1:}}%
  \noindent\begin{minipage}[t][\termrowheight][t]{\linewidth}%
    \vspace*{\termrowinset}%
    \textbf{\textcolor{navy}{#1:}}\quad%
    \blank{\dimexpr\linewidth-\aps@termwd-1.6em\relax}%
  \end{minipage}\par}
\newcommand{\termblanklong}[1]{%
  \noindent\textbf{\textcolor{navy}{#1:}}\\[1pt]%
  \writeline\\[1pt]\writeline\\[3pt]}

% ── Page header: \pageheader{Unit X, Lesson Y.Z}{Document Type} ───────────────
% Produces the full-width navy colorbox header used on all student documents.
\newcommand{\pageheader}[2]{%
    \noindent
    \colorbox{navy}{%
        \parbox{\dimexpr\linewidth}{%
            \vspace{6pt}%
            \color{white}\textbf{\large Statistics \hfill #1}\\[2pt]%
            {\color{skymid}\small\textbf{#2}}%
            \vspace{6pt}%
        }%
    }%
    \vspace{1.5em}\par\noindent}

% ── Cover banner: \coverbanner{Unit 1}{Lesson 1.3 \quad Title} ────────────────
% The full-bleed navy band at the top of a packet cover. The band is MEASURED
% from the title block it holds, so a long lesson title that wraps to a second
% line grows the band instead of spilling out the bottom of it. Hard-coding the
% fill height (the old \fill ... [yshift=-0.9in] pattern) clipped the lesson
% line on every long title once the covers moved to 12pt.
\newsavebox{\aps@bannerbox}
\newlength{\aps@bannerht}
\newlength{\coverbannerpad}
\setlength{\coverbannerpad}{0.16in}       % breathing room above and below the text
\newcommand{\coverbanner}[2]{%
  \sbox{\aps@bannerbox}{%
    \begin{minipage}{\dimexpr\paperwidth-1.4in\relax}%
      \centering
      {\color{white}\textbf{\LARGE \CourseName}}\\[4pt]
      {\color{skymid}\large\textbf{#1}}\\[6pt]
      {\color{white}\textbf{\large #2}}%
    \end{minipage}}%
  \setlength{\aps@bannerht}{\dimexpr\ht\aps@bannerbox+\dp\aps@bannerbox
                            +2\coverbannerpad\relax}%
  \noindent\begin{tikzpicture}[remember picture, overlay]
    \fill[navy] (current page.north west)
      rectangle ([yshift=-\aps@bannerht]current page.north east);
    \node[anchor=north, inner sep=0pt]
      at ([yshift=-\coverbannerpad]current page.north) {\usebox{\aps@bannerbox}};
  \end{tikzpicture}\par
  % The text body starts 0.6in below the page edge (geometry top=0.6in), so
  % reserve only what the band overruns that, plus a gap under the band.
  \vspace*{\dimexpr\aps@bannerht-0.6in+0.16in\relax}%
}

