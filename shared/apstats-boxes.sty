% ── steptable / \step — a printed solution, aligned on its relation ───────────
% The other half of the work rule. `work` is for steps the STUDENT writes (blank
% reserves, key prints). This is for steps that are PRINTED IN BOTH — the
% "justify every line" tables, where the computation is given and the student
% names the reason beside it (which condition this line checks, which quantity
% this line is estimating).
%
% The alignment requirement is the same either way: one statement per line, all
% lines aligned on the relation. A plain single-column table cannot do that —
% $z=(x-\mu)/\sigma$ over $z=(74-70)/2.5$ puts the two `=` signs in different
% places — so the step is split into a right-aligned left side and a
% left-aligned relation+right side, which lines the relations up in one column.
%
%   \begin{steptable}[Why this step]        % or bare for the default heading
%     \step{z}{=\dfrac{x-\mu}{\sigma}}{Standardizing formula}
%     \step{}{=\dfrac{74-70}{2.5}}{\blank{6.0cm}}
%     \step{}{=1.6}{\blank{6.0cm}}
%   \end{steptable}
%
% Argument 2 starts with the relation (=, <, >, \le, \ge, \approx) and is set
% with a leading {} so TeX spaces it as a relation rather than as a leading
% symbol. Identical in the blank and the key except for column 3, so it cannot
% drift. The body is captured with `+b` rather than split across begin/end code:
% tabularx rescans its body to solve the X column, so it must see a complete
% one. Splitting \begin{tabularx} and \end{tabularx} across an environment
% definition fails with "Missing } inserted" at the \end.
\NewDocumentEnvironment{steptable}{O{Reason for this step} +b}
  {\begin{center}%
   \renewcommand{\arraystretch}{1.6}%
   \begin{tabularx}{\linewidth}{@{}r@{}l X@{}}
   \hline
   \multicolumn{2}{@{}l}{\textbf{Step}} & \textbf{#1} \\
   \hline
   #2
   \hline
   \end{tabularx}%
   \end{center}}
  {}

\newcommand{\step}[3]{$#1$ & ${}#2$ & #3 \\}

% \steprel — same row, but the RELATION ITSELF is what the student supplies, so
% the middle cell is arbitrary text rather than math. Use it when the direction
% of the comparison is the point (a one-sided alternative, a p-value against
% alpha). It still lands in the relation column, lined up with every \step above
% and below it.
%   \steprel{p\text{-value}}{\blank{0.9cm} $\alpha$}{\blank{6.0cm}}
%   \steprel{p\text{-value}}{\ans{$<$} $\alpha$}{\ans{Reject $H_0$}}
\newcommand{\steprel}[3]{$#1$ & #2 & #3 \\}

% ── Teacher notes ─────────────────────────────────────────────────────────────
% TEACHER NOTES LIVE IN THE LESSON PLAN, one per component, titled for it:
%
%   \begin{teachernote}[Warm-Up] ... \end{teachernote}   → "Teacher Note: Warm-Up"
%   \begin{teachernote}          ... \end{teachernote}   → "Teacher Note"
%
% They used to be appended to each _key, which made the key longer than its
% blank for no student-facing reason — the one block with no counterpart in the
% blank, and after the work rule the main thing still costing a packet blank
% pages. The lesson plan is teacher-facing already and sits outside the
% page-matched packet, so that is where the prose belongs.
%
% Defined here rather than in apstats-key because the lesson plan loads -boxes
% only. The optional argument keeps every pre-existing bare \begin{teachernote}
% in an un-migrated key compiling unchanged.
\tcbset{teachernotestyle/.style={
    enhanced,
    colback=redbg, colframe=redacc, boxrule=0.7pt, arc=1.5mm,
    left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
    fonttitle=\bfseries\small\color{white},   % \small like every other box title
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=redacc, colframe=redacc, arc=1mm},
    breakable
}}
\NewDocumentEnvironment{teachernote}{o}
  {\begin{tcolorbox}[teachernotestyle,
      title={Teacher Note\IfValueT{#1}{: #1}}]}
  {\end{tcolorbox}}

